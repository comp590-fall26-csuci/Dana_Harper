[4802.385455, "o", "\r\u001b[2d\u001b[36m#!/bin/bash\r\u001b[4d# Lab 2 - Dana Harper\r\u001b[5d# Reads OverTheWire Bandit passwords, prints them alphabetically,\r\u001b[6d# and writes each one to its own file.\r\u001b[8d"]
[4802.386017, "o", "\u001b[39m\u001b(B\u001b[mpasswordFile\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"passwords.txt\"\r\u001b[9d\u001b[39m\u001b(B\u001b[moutputDir\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"password_files\"\r\u001b[11d\u001b(B\u001b[0m\u001b[32mif\u001b[39m\u001b(B\u001b[m \u001b[32m[[\u001b[39m\u001b(B\u001b[m \u001b[32m!\u001b(B\u001b[0;1m\u001b[35m -f\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$passwordFile\"\u001b[39m\u001b(B\u001b[m \u001b[32m]];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[12;5H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Error: $passwordFile not found\"\u001b[13;5H\u001b(B\u001b[0m\u001b[32mexit\u001b[39m\u001b(B\u001b[m 1\r\u001b[14d\u001b[32mfi\r\u001b[16d"]
[4802.386676, "o", "\u001b(B\u001b[0;1m\u001b[34mmkdir\u001b[35m -p\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$outputDir\"\r\u001b[18d\u001b[39m\u001b(B\u001b[mcount\u001b[32m=\u001b[39m\u001b(B\u001b[m1\r\u001b[19d\u001b[32mfor\u001b[39m\u001b(B\u001b[m password \u001b[32min\u001b[39m\u001b(B\u001b[m \u001b[32m$(\u001b(B\u001b[0;1m\u001b[34msort\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$passwordFile\"\u001b(B\u001b[0m\u001b[32m);\u001b[39m\u001b(B\u001b[m \u001b[32mdo\u001b[20;5H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[21;5H\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[39m\u001b(B\u001b[m \u001b[32m>\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$outputDir/password_${count}.txt\"\u001b[22;5H\u001b(B\u001b[0m\u001b[32m((\u001b[39m\u001b(B\u001b[mcount++\u001b[32m))\r\u001b[23ddone\r\u001b[25d\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Wrote $((count - 1)) files to $outputDir/\"\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
[4862.061818, "o", "\u001b[?25l"]
[4862.062333, "o", "\u001b[50;15H      \u001b(B\u001b[0;7mM-D\u001b(B\u001b[m DOS Format      \u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Append\u001b[57G    \u001b(B\u001b[0;7mM-B\u001b(B\u001b[m Backup File     \u001b(B\u001b[0;7m^T\u001b(B\u001b[m Browse\u001b[K\u001b[51;2H\u001b(B\u001b[0;7mC\u001b(B\u001b[m Cancel           \u001b(B\u001b[0;7mM-M\u001b(B\u001b[m Mac Format      \u001b(B\u001b[0;7mM-P\u001b(B\u001b[m Prepend         \u001b(B\u001b[0;7m^Q\u001b(B\u001b[m Discard buffer\u001b[K\u001b[50;90H\r\u001b[A\u001b(B\u001b[0;7mWrite to File: lab2.sh                                                                                \u001b[49;23H\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
[4865.362393, "o", "\u001b[?25l"]
[4865.362921, "o", "\u001b[49;44H\u001b[1K \u001b(B\u001b[0;7m[ Writing... ]\u001b(B\u001b[m\u001b[K"]
[4865.366551, "o", "\u001b[1;60H\u001b(B\u001b[0;7m \u001b[101G\u001b(B\u001b[m\u001b[49;43H\u001b(B\u001b[0;7m[ Wrote 24 lines ]\u001b(B\u001b[m"]
[4865.366772, "o", "\u001b[50;15H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut  \u001b[57G\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location   \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[51;2H\u001b(B\u001b[0;7mX\u001b(B\u001b[m Exit       \u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste      \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[?12l\u001b[?25h\u001b[25;49H"]
