[2046.427131, "o", "\u001b[1;60H\u001b(B\u001b[0;7m \u001b[102G\u001b(B\u001b[m\u001b[39;43H\u001b(B\u001b[0;7m[ Wrote 15 lines ]\u001b(B\u001b[m\u001b[40;15H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut  \u001b[57G"]
