[2015.293043, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m fib_recursive\u001b[39m\u001b(B\u001b[m(n):\u001b[4;5H\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m n < 2:\u001b[5;9H\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m n\u001b[6;5H\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m fib_recursive(n - 1) + fib_recursive(n - 2)\r\u001b[9d\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m main\u001b[39m\u001b(B\u001b[m():\u001b[10;5H\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"output/fibonacci.txt\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"w\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m f:\u001b[11;9H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m i \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m range(25):\u001b[12;13Hf.write(f\u001b(B\u001b[0;1m\u001b[32m\"{fib_recursive(i)}\u001b(B\u001b[0m\u001b[38;5;148m\\n\u001b(B\u001b[0;1m\u001b[32m\"\u001b[39m\u001b(B\u001b[m)\r\u001b[15d\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m __name__ == \u001b(B\u001b[0;1m\u001b[32m\"__main__\"\u001b[39m\u001b(B\u001b[m:\u001b[16;5Hmain()\u001b[?12l\u001b[?25h"]
[2041.371115, "o", "\u001b[?25l\u001b[40;15H      \u001b(B\u001b[0;7mM-D\u001b(B\u001b[m DOS Format      \u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Append\u001b[57G    \u001b(B\u001b[0;7mM-B\u001b(B\u001b[m Backup File     \u001b(B\u001b[0;7m^T\u001b(B\u001b[m Browse\u001b[K\u001b[41;2H"]
