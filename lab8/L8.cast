[191.493983, "o", "\u001b[?2004h> "]
[216.070543, "o", "\u001b[7mFROM docker.io/library/debian:stable-slim\u001b[27m\r\n\r\n\r\u001b[7mRUN apt-get update && \\\u001b[27m\r\n\r\u001b[7m    apt-get install -y --no-install-recommends build-essential && \\\u001b[27m\r\n\r\u001b[7m    rm -rf /var/lib/apt/lists/*\u001b[27m\r\n\r\n\r\u001b[7mWORKDIR /usr/src/app\u001b[27m\r\n\r\n\r\u001b[7mCOPY Makefile .\u001b[27m\r\n\r\u001b[7mCOPY main.c fibonacci.c ./\u001b[27m\r\n\r\u001b[7mCOPY headers/ ./headers/\u001b[27m\r\n\r\u001b[7mCOPY tests/ ./tests/\u001b[27m\r\n\r\n\r\u001b[7mRUN make all\u001b[27m\r\n\r\u001b[7mRUN make fib_test\u001b[27m\r\n\r\n\r\u001b[7mCMD [\"./fib_test\"]\u001b[27m\r\n\r\u001b[7mEOF\u001b[27m"]
[217.948873, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\bFROM docker.io/library/debian:stable-slim\r\n\r\n\rRUN apt-get update && \\\r\n\r    apt-get install -y --no-install-recommends build-essential && \\\r\n\r    rm -rf /var/lib/apt/lists/*\r\n\r\n\rWORKDIR /usr/src/app\r\n\r\n\rCOPY Makefile .\r\n\rCOPY main.c fibonacci.c ./\r\n\rCOPY headers/ ./headers/\r\n\rCOPY tests/ ./tests/\r\n\r\n\rRUN make all\r\n\rRUN make fib_test\r\n\r\n\rCMD [\"./fib_test\"]\r\n\rEOF\r\n\u001b[?2004l\r"]
[217.963808, "o", "\u001b[?2004h\u001b]0;dana@DebianVB: ~/Dana_Harper/lab8/app\u0007\u001b[01;32mdana@DebianVB\u001b[00m:\u001b[01;34m~/Dana_Harper/lab8/app\u001b[00m$ "]
