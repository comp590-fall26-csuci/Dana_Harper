[229.82667, "o", "FROM docker.io/library/debian:stable-slim"]
[229.828848, "o", "\r\n"]
[229.830136, "o", "\r\nRUN apt-get update && \\\r\n    apt-get install -y --no-install-recommends build-essential && \\\r\n    rm -rf /var/lib/apt/lists/*\r\n\r\nWORKDIR /usr/src/app\r\n\r\nCOPY Makefile .\r\nCOPY main.c fibonacci.c ./\r\nCOPY headers/ ./headers/\r\nCOPY tests/ ./tests/\r\n\r\nRUN make all\r\nRUN make fib_test\r\n\r\nCMD [\"./fib_test\"]\r\n"]
